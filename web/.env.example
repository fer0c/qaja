# Server-to-server URL (local dev o Railway Private Networking):
# En Railway: API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
API_INTERNAL_URL=http://127.0.0.1:8000

# Opcional si llamas a FastAPI directo desde el navegador:
# En Railway: NEXT_PUBLIC_API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_API_URL=http://localhost:8000
